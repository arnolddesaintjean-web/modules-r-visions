  <!-- REDACTION -->
  <section class="panel" id="panel-redac">
    <div class="redac-select" id="redac-select"></div>
    <div class="redac-grid">
      <div>
        <div class="subject-card">
          <span class="tag" id="redac-tag">Séance 1</span>
