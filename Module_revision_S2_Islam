</main>

<script>
(function () {
  const STORAGE_KEY = 'hg5e-seq2-islam-bagdad';
  const DAY = 24 * 60 * 60 * 1000;
  const LEVEL_INTERVALS = [1, 3, 7, 14]; // jours conseillés pour les niveaux 1 à 4

  function todayISO() { return new Date().toISOString().slice(0, 10); }
  function addDaysISO(days) { return new Date(Date.now() + days * DAY).toISOString().slice(0, 10); }
  function fmtDate(iso) {
    const d = new Date(iso + 'T00:00:00');
    return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
  }

  // ---------- Contenu : 20 flashcards / 20 QCM (une question par flashcard) ----------
  const flashcards = [
    { theme: 'S1 — Naissance de l\'islam', q: "Qu'est-ce que l'Hégire ?", a: "Le départ de Muhammad de La Mecque pour Médine en 622 ; c'est le point de départ du calendrier musulman." },
    { theme: 'S1 — Naissance de l\'islam', q: "En quel siècle et dans quelle région naît l'islam ?", a: "Au VIIe siècle, en Arabie." },
    { theme: 'S1 — Naissance de l\'islam', q: "Qui est Muhammad ?", a: "Le prophète de l'islam, né à La Mecque, mort en 632." },
    { theme: 'S1 — Naissance de l\'islam', q: "Pourquoi distingue-t-on une source contemporaine d'une source postérieure sur les débuts de l'islam ?", a: "Parce que les récits religieux détaillés (comme la Vie du prophète, IXe siècle) sont écrits près de deux siècles après les faits du VIIe siècle." },
    { theme: 'S2 — Empire omeyyade', q: "Qu'est-ce qu'un calife ?", a: "Le successeur du prophète, chef politique et religieux de la communauté musulmane." },
    { theme: 'S2 — Empire omeyyade', q: "Quelles dates encadrent la dynastie omeyyade ?", a: "661 à 750, avec Damas pour capitale." },
    { theme: 'S2 — Empire omeyyade', q: "Qu'a changé la réforme monétaire d'Abd al-Malik ?", a: "Les monnaies deviennent purement épigraphiques et islamiques : plus aucune image, seulement des inscriptions religieuses." },
    { theme: 'S2 — Empire omeyyade', q: "Que signifient arabisation et islamisation ?", a: "La politique d'unification de l'empire par la diffusion de la langue arabe et de la religion musulmane." },
    { theme: 'S3 — Apogée abbasside', q: "Quand et où est fondée Bagdad ?", a: "En 762, elle devient la capitale de l'empire abbasside." },
    { theme: 'S3 — Apogée abbasside', q: "Qui est Haroun al-Rachid ?", a: "Calife abbasside (786-809), figure de l'apogée de Bagdad, personnage des Mille et Une Nuits." },
    { theme: 'S3 — Apogée abbasside', q: "Qu'est-ce qu'un dhimmi ?", a: "Le statut protégé des non-musulmans (juifs, chrétiens) dans l'empire, en échange d'un impôt spécifique." },
    { theme: 'S3 — Apogée abbasside', q: "Jusqu'à quand la population de l'empire n'est-elle pas majoritairement musulmane ?", a: "Jusqu'au XIIe siècle : l'empire reste marqué par une grande diversité religieuse." },
    { theme: 'S4 — Morcellement', q: "Qu'est-ce que le morcellement du califat ?", a: "La fragmentation progressive du pouvoir califal en plusieurs pouvoirs concurrents à partir du Xe siècle." },
    { theme: 'S4 — Morcellement', q: "D'où vient la division entre sunnites et chiites ?", a: "D'un désaccord sur la succession de Muhammad, dès sa mort en 632." },
    { theme: 'S4 — Morcellement', q: "Qui sont les Fatimides ?", a: "Une dynastie chiite qui fonde Le Caire en 969 et installe un califat rival de celui de Bagdad." },
    { theme: 'S4 — Morcellement', q: "Que s'est-il passé en 1258 ?", a: "La prise de Bagdad par les Mongols : le dernier calife abbasside disparaît, c'est la fin de l'empire arabo-persan." },
    { theme: 'S5 — Contacts en Méditerranée', q: "Pourquoi Charlemagne et Haroun al-Rachid échangent-ils des ambassades ?", a: "Pour rendre hommage l'un à l'autre et rechercher une alliance : ils ont un ennemi commun, les Omeyyades de Cordoue." },
    { theme: 'S5 — Contacts en Méditerranée', q: "Pourquoi Al-Andalus est-elle importante pour l'histoire des sciences ?", a: "C'est un foyer majeur de transmission des savoirs antiques (mathématiques, astronomie, médecine) vers l'Occident latin, via des traducteurs comme Gérard de Crémone à Tolède." },
    { theme: 'S5 — Contacts en Méditerranée', q: "Qu'est-ce que la Reconquista ?", a: "La reconquête progressive de la péninsule Ibérique par les royaumes chrétiens, entre l'an 1000 et 1212." },
    { theme: 'S5 — Contacts en Méditerranée', q: "Qu'est-ce qu'une croisade ?", a: "Une expédition militaire chrétienne vers l'Orient, appelée par le pape à partir de 1095 (appel d'Urbain II)." },
  ];

  const qcm = [
    { theme: 'S1', q: "Que désigne l'Hégire ?", options: ["La naissance de Muhammad", "Le départ de Muhammad de La Mecque pour Médine (622)", "La mort de Muhammad", "La fondation de Bagdad"], correct: 1, explain: "L'Hégire, en 622, marque le début du calendrier musulman." },
    { theme: 'S1', q: "En quel siècle naît l'islam ?", options: ["Ve siècle", "VIe siècle", "VIIe siècle", "VIIIe siècle"], correct: 2, explain: "L'islam naît au VIIe siècle, en Arabie." },
    { theme: 'S1', q: "Qui est Muhammad ?", options: ["Un calife omeyyade", "Le prophète de l'islam", "Un empereur byzantin", "Un traducteur de Tolède"], correct: 1, explain: "Muhammad est le prophète fondateur de l'islam, mort en 632." },
    { theme: 'S1', q: "Pourquoi la Vie du prophète (IXe s.) n'est-elle pas une source directe des faits du VIIe siècle ?", options: ["Elle est écrite en latin", "Elle est écrite près de deux siècles après les faits", "Elle ne parle pas de Muhammad", "Elle est plus ancienne que la monnaie de 686"], correct: 1, explain: "Ce texte religieux construit le récit des origines environ deux siècles après les événements." },
    { theme: 'S2', q: "Qu'est-ce qu'un calife ?", options: ["Un gouverneur byzantin", "Le successeur du prophète, chef politique et religieux", "Un savant traducteur", "Un chef militaire mongol"], correct: 1, explain: "Le calife est le successeur du prophète à la tête de la communauté musulmane." },
    { theme: 'S2', q: "Quelle dynastie règne de 661 à 750 ?", options: ["Les Abbassides", "Les Fatimides", "Les Omeyyades", "Les Mongols"], correct: 2, explain: "Les Omeyyades règnent depuis Damas de 661 à 750." },
    { theme: 'S2', q: "Que change la réforme monétaire d'Abd al-Malik ?", options: ["Elle ajoute des portraits de calife", "Elle supprime les images au profit d'inscriptions religieuses", "Elle instaure le papier-monnaie", "Elle adopte la monnaie byzantine"], correct: 1, explain: "Les monnaies deviennent purement épigraphiques, affirmant une identité islamique propre." },
    { theme: 'S2', q: "Que signifie « islamisation » de l'empire omeyyade ?", options: ["La conversion forcée de tous les habitants", "La diffusion de la religion musulmane dans l'administration et la société", "L'interdiction du christianisme", "La construction d'églises"], correct: 1, explain: "L'islamisation accompagne l'arabisation dans la politique d'unification de l'empire." },
    { theme: 'S3', q: "En quelle année Bagdad est-elle fondée ?", options: ["622", "750", "762", "969"], correct: 2, explain: "Bagdad est fondée en 762 et devient la capitale abbasside." },
    { theme: 'S3', q: "Qui est Haroun al-Rachid ?", options: ["Un calife omeyyade", "Un calife abbasside (786-809)", "Un pape", "Un roi wisigoth"], correct: 1, explain: "Haroun al-Rachid incarne l'apogée de Bagdad sous les Abbassides." },
    { theme: 'S3', q: "Qu'est-ce qu'un dhimmi ?", options: ["Un musulman converti", "Un non-musulman protégé, soumis à un impôt spécifique", "Un calife régional", "Un croisé"], correct: 1, explain: "Le statut de dhimmi protège juifs et chrétiens dans l'empire musulman." },
    { theme: 'S3', q: "Jusqu'à quand la population de l'empire n'est-elle pas majoritairement musulmane ?", options: ["Le VIIIe siècle", "Le Xe siècle", "Le XIIe siècle", "Le XIVe siècle"], correct: 2, explain: "La conversion majoritaire à l'islam n'intervient qu'à partir du XIIe siècle." },
    { theme: 'S4', q: "Qu'est-ce que le morcellement du califat ?", options: ["Son extension territoriale", "Sa fragmentation en pouvoirs concurrents", "Sa conversion au christianisme", "Son alliance avec Byzance"], correct: 1, explain: "À partir du Xe siècle, plusieurs califats rivaux coexistent." },
    { theme: 'S4', q: "D'où vient la division entre sunnites et chiites ?", options: ["D'un désaccord sur la succession de Muhammad", "D'une guerre avec Byzance", "D'une réforme monétaire", "D'un désaccord sur le calendrier"], correct: 0, explain: "Ce désaccord, dès la mort de Muhammad en 632, fonde la division." },
    { theme: 'S4', q: "Qui fonde Le Caire en 969 ?", options: ["Les Omeyyades", "Les Abbassides", "Les Fatimides", "Les Mongols"], correct: 2, explain: "Les Fatimides, chiites, fondent Le Caire comme capitale rivale de Bagdad." },
    { theme: 'S4', q: "Que se passe-t-il en 1258 ?", options: ["La fondation de Bagdad", "L'Hégire", "La prise de Bagdad par les Mongols", "Le début des croisades"], correct: 2, explain: "En 1258, la prise de Bagdad par les Mongols met fin au califat abbasside." },
    { theme: 'S5', q: "Pourquoi Charlemagne et Haroun al-Rachid échangent-ils des ambassades ?", options: ["Ils sont cousins", "Ils ont un ennemi commun, les Omeyyades de Cordoue", "Ils préparent une croisade ensemble", "Ils partagent la même religion"], correct: 1, explain: "Cette alliance diplomatique s'explique par un adversaire commun." },
    { theme: 'S5', q: "Quel rôle joue Al-Andalus dans l'histoire des sciences ?", options: ["Elle isole l'Europe du monde arabe", "Elle transmet les savoirs antiques vers l'Occident latin", "Elle interdit les traductions", "Elle est coupée du monde musulman"], correct: 1, explain: "Des traducteurs comme Gérard de Crémone travaillent à Tolède, en Al-Andalus." },
    { theme: 'S5', q: "Qu'est-ce que la Reconquista ?", options: ["La conquête arabe de l'Espagne", "La reconquête chrétienne de la péninsule Ibérique", "La prise de Bagdad", "Une croisade en Orient"], correct: 1, explain: "La Reconquista s'étend de l'an 1000 à 1212 environ." },
    { theme: 'S5', q: "Qui appelle à la première croisade, en 1095 ?", options: ["Le calife de Bagdad", "L'empereur byzantin", "Le pape Urbain II", "Charlemagne"], correct: 2, explain: "Urbain II lance l'appel à la croisade en 1095." },
  ];

  // ---------- Contenu : questions de rédaction (une par séance, S1 à S6) ----------
  const redacQuestions = [
    {
      tag: 'Séance 1', subject: "En 2 à 3 phrases, explique qui, où, quand et comment naît l'islam, et par quels types de sources nous le savons.",
      consigne: "Utilise le vocabulaire : Hégire, monothéisme, prophète.",
      expected: "L'islam naît au VIIe siècle en Arabie, autour du prophète Muhammad. Nous le savons grâce à des sources contemporaines (monnaies, graffitis) et à des récits religieux rédigés plus tard, au IXe siècle (Vie du prophète).",
      criteria: ["J'ai situé l'islam dans le temps (VIIe siècle) et dans l'espace (Arabie)", "J'ai cité le nom du prophète Muhammad", "J'ai distingué un type de source contemporaine et un type de source postérieure"],
    },
    {
      tag: 'Séance 2', subject: "En 2 à 3 phrases, explique comment les Omeyyades construisent un vaste empire arabe et islamique.",
      consigne: "Utilise le vocabulaire : calife, empire, arabisation, islamisation.",
      expected: "Les Omeyyades, califes de 661 à 750, étendent un empire immense depuis Damas. Le calife Abd al-Malik unifie cet empire par l'arabisation et l'islamisation, notamment en réformant les monnaies pour qu'elles deviennent purement islamiques.",
      criteria: ["J'ai cité la dynastie omeyyade et ses dates (661-750)", "J'ai expliqué ce que signifient arabisation et islamisation", "J'ai donné un exemple concret (réforme monétaire ou mosquée de Damas)"],
    },
    {
      tag: 'Séance 3', subject: "En 2 à 3 phrases, explique en quoi l'empire abbasside est une civilisation marquée par la diversité.",
      consigne: "Utilise le vocabulaire : dhimmi, diversité culturelle, commandeur des croyants.",
      expected: "Sous les Abbassides, Bagdad devient le centre d'un empire cosmopolite, marqué par une grande diversité religieuse, linguistique et artistique. Les non-musulmans (dhimmis) y sont protégés, et la population reste majoritairement non musulmane jusqu'au XIIe siècle.",
      criteria: ["J'ai cité Bagdad et son rôle de capitale abbasside", "J'ai expliqué le statut de dhimmi", "J'ai mentionné au moins un aspect de la diversité (religieuse, culturelle ou linguistique)"],
    },
    {
      tag: 'Séance 4', subject: "En 2 à 3 phrases, explique pourquoi le califat perd son unité et ce qui se passe en 1258.",
      consigne: "Utilise le vocabulaire : morcellement, sunnites, chiites, califat fatimide.",
      expected: "Dès le Xe siècle, le califat abbasside se fragmente : des pouvoirs régionaux et des califats rivaux apparaissent, comme celui des Fatimides chiites au Caire. En 1258, la prise de Bagdad par les Mongols met fin au califat abbasside.",
      criteria: ["J'ai expliqué la notion de morcellement", "J'ai mentionné la division sunnites/chiites ou les Fatimides", "J'ai cité la date de 1258 et son événement"],
    },
    {
      tag: 'Séance 5', subject: "En 2 à 3 phrases : les contacts entre chrétientés et islam sont-ils uniquement guerriers ? Donne un exemple pacifique et un exemple conflictuel.",
      consigne: "Utilise le vocabulaire : ambassade, Al-Andalus, Reconquista, croisade.",
      expected: "Non, les contacts entre chrétientés et islam sont à la fois pacifiques et conflictuels. Par exemple, les ambassades entre Charlemagne et Haroun al-Rachid ou la transmission des savoirs à Al-Andalus sont pacifiques, tandis que la Reconquista ou les croisades sont des affrontements.",
      criteria: ["J'ai répondu clairement à la question (non, ce n'est pas uniquement guerrier)", "J'ai donné un exemple pacifique précis", "J'ai donné un exemple conflictuel précis"],
    },
    {
      tag: 'Séance 6', subject: "En quelques phrases, résume la séquence : comment l'empire arabo-musulman s'est-il constitué, organisé puis fragmenté, et quelles relations a-t-il entretenues avec les chrétientés ?",
      consigne: "C'est un bilan : reprends les grandes étapes vues depuis la séance 1.",
      expected: "Né en Arabie au VIIe siècle, l'islam donne naissance à un empire qui s'étend rapidement sous les Omeyyades, puis connaît son apogée sous les Abbassides à Bagdad, avant de se fragmenter à partir du Xe siècle jusqu'à la prise de Bagdad par les Mongols en 1258. Tout au long de cette période, cet empire entretient avec les chrétientés des relations à la fois pacifiques (diplomatie, savoirs) et conflictuelles (Reconquista, croisades).",
      criteria: ["J'ai retracé les grandes étapes chronologiques (Omeyyades, Abbassides, morcellement)", "J'ai mentionné 1258 et la prise de Bagdad", "J'ai évoqué les deux types de relations avec les chrétientés"],
    },
  ];

  // ---------- État persistant ----------
  let state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
  state.cards = state.cards || flashcards.map(() => ({ level: 0, nextReview: todayISO() }));
  if (state.cards.length !== flashcards.length) {
    // sécurité si le contenu a changé entre deux versions du module
    while (state.cards.length < flashcards.length) state.cards.push({ level: 0, nextReview: todayISO() });
    state.cards = state.cards.slice(0, flashcards.length);
  }
  state.qcmBest = state.qcmBest || 0;
  state.redac = state.redac || redacQuestions.map(() => ({ text: '', checklist: [] }));

  function save() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }

  // ---------- Onglets ----------
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
      if (btn.dataset.tab === 'dashboard') updateDashboard();
    });
  });

  // ---------- Flashcards (répétition espacée à 4 niveaux) ----------
  let fIndex = 0, fFlipped = false;
  const flashInner = document.getElementById('flash-inner');

  function renderFlash() {
    const c = flashcards[fIndex];
    const cardState = state.cards[fIndex];
    fFlipped = false;
    flashInner.classList.remove('flipped');
    document.getElementById('flash-theme').textContent = c.theme;
    document.getElementById('flash-q').textContent = c.q;
    document.getElementById('flash-a').textContent = c.a;
    document.getElementById('flash-count').textContent = `Carte ${fIndex + 1} / ${flashcards.length}`;
    const statusEl = document.getElementById('flash-status');
    const due = cardState.nextReview <= todayISO();
    if (due) {
      statusEl.textContent = 'À revoir aujourd\'hui';
      statusEl.classList.add('due');
    } else {
      statusEl.textContent = 'Prochaine révision : ' + fmtDate(cardState.nextReview);
      statusEl.classList.remove('due');
    }
  }
  document.getElementById('flash-card').addEventListener('click', () => {
    fFlipped = !fFlipped;
    flashInner.classList.toggle('flipped', fFlipped);
  });
  document.getElementById('flash-next').addEventListener('click', () => { fIndex = (fIndex + 1) % flashcards.length; renderFlash(); });
  document.getElementById('flash-prev').addEventListener('click', () => { fIndex = (fIndex - 1 + flashcards.length) % flashcards.length; renderFlash(); });

  function gradeCard(grade) {
    const c = state.cards[fIndex];
    if (grade === 'revoir') {
      c.level = 0;
      c.nextReview = todayISO();
    } else if (grade === 'presque') {
      c.nextReview = addDaysISO(1);
    } else if (grade === 'sais') {
      c.nextReview = addDaysISO(LEVEL_INTERVALS[c.level]);
      c.level = Math.min(c.level + 1, LEVEL_INTERVALS.length - 1);
    }
    save();
    setTimeout(() => { fIndex = (fIndex + 1) % flashcards.length; renderFlash(); updateDashboard(); }, 180);
  }
  document.getElementById('btn-revoir').addEventListener('click', () => gradeCard('revoir'));
  document.getElementById('btn-presque').addEventListener('click', () => gradeCard('presque'));
  document.getElementById('btn-sais').addEventListener('click', () => gradeCard('sais'));

  // ---------- QCM ----------
  let qIndex = 0, qAnswers = [];
  function renderQcm() {
    if (qIndex >= qcm.length) { renderQcmResult(); return; }
    document.getElementById('qcm-active').style.display = 'block';
    document.getElementById('qcm-result').style.display = 'none';
    const q = qcm[qIndex];
    document.getElementById('qcm-theme').textContent = q.theme;
    document.getElementById('qcm-q').textContent = q.q;
    document.getElementById('qcm-progress').style.width = Math.round((qIndex / qcm.length) * 100) + '%';
    const optsEl = document.getElementById('qcm-options');
    optsEl.innerHTML = '';
    const already = qAnswers[qIndex];
    q.options.forEach((opt, i) => {
      const b = document.createElement('button');
      b.className = 'qcm-opt';
      b.textContent = opt;
      if (already !== undefined) {
        b.disabled = true;
        if (i === q.correct) b.classList.add('correct');
        else if (i === already) b.classList.add('wrong');
      } else {
        b.addEventListener('click', () => { qAnswers[qIndex] = i; renderQcm(); });
      }
      optsEl.appendChild(b);
    });
    const explainEl = document.getElementById('qcm-explain');
    if (already !== undefined) {
      explainEl.textContent = q.explain;
      explainEl.classList.add('show');
    } else {
      explainEl.classList.remove('show');
    }
    document.getElementById('qcm-prev').style.visibility = qIndex === 0 ? 'hidden' : 'visible';
    document.getElementById('qcm-next').disabled = already === undefined;
  }
  document.getElementById('qcm-next').addEventListener('click', () => { qIndex++; renderQcm(); });
  document.getElementById('qcm-prev').addEventListener('click', () => { if (qIndex > 0) { qIndex--; renderQcm(); } });

  function renderQcmResult() {
    document.getElementById('qcm-active').style.display = 'none';
    document.getElementById('qcm-result').style.display = 'block';
    const score = qAnswers.filter((a, i) => a === qcm[i].correct).length;
    if (score > state.qcmBest) { state.qcmBest = score; save(); }
    document.getElementById('qcm-final-score').textContent = `${score} / ${qcm.length}`;
    const pct = Math.round((score / qcm.length) * 100);
    const msg = pct >= 80 ? "Très solide ! Ces notions sont acquises." : pct >= 50 ? "Pas mal, repasse par les flashcards sur les questions ratées." : "Retourne d'abord voir les flashcards avant de retenter le QCM.";
    document.getElementById('qcm-final-msg').textContent = msg;
    const wrong = qAnswers.map((a, i) => (a !== qcm[i].correct ? i : -1)).filter(i => i >= 0);
    const priorityEl = document.getElementById('qcm-priority');
    const listEl = document.getElementById('qcm-priority-list');
    if (wrong.length > 0) {
      priorityEl.style.display = 'block';
      listEl.innerHTML = '';
      wrong.forEach(i => {
        const li = document.createElement('li');
        li.textContent = flashcards[i].theme + ' — ' + flashcards[i].q;
        listEl.appendChild(li);
      });
    } else {
      priorityEl.style.display = 'none';
    }
    updateDashboard();
  }
  document.getElementById('qcm-restart').addEventListener('click', () => { qIndex = 0; qAnswers = []; renderQcm(); });

  // ---------- Rédaction ----------
  let rIndex = 0;
  const redacSelectEl = document.getElementById('redac-select');
  redacQuestions.forEach((rq, i) => {
    const b = document.createElement('button');
    b.textContent = rq.tag;
    b.addEventListener('click', () => { saveCurrentEssay(); rIndex = i; renderRedac(); });
    redacSelectEl.appendChild(b);
  });

  function saveCurrentEssay() {
    state.redac[rIndex].text = document.getElementById('essay').value;
    save();
  }

  function isValidated(i) {
    const r = state.redac[i];
    return r.checklist.filter(Boolean).length === redacQuestions[i].criteria.length && redacQuestions[i].criteria.length > 0;
  }

  function renderRedac() {
    const rq = redacQuestions[rIndex];
    const rState = state.redac[rIndex];
    document.querySelectorAll('.redac-select button').forEach((b, i) => {
      b.classList.toggle('active', i === rIndex);
      b.classList.toggle('validated', isValidated(i));
    });
    document.getElementById('redac-tag').textContent = rq.tag;
    document.getElementById('redac-subject').textContent = rq.subject;
    document.getElementById('redac-consigne').textContent = rq.consigne;
    document.getElementById('redac-expected').textContent = rq.expected;
    document.getElementById('redac-expected').classList.remove('show');

    const checklistEl = document.getElementById('redac-checklist');
    checklistEl.innerHTML = '';
    rq.criteria.forEach((crit, i) => {
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.checked = !!rState.checklist[i];
      input.addEventListener('change', () => {
        rState.checklist[i] = input.checked;
        save();
        renderRedac();
        updateDashboard();
      });
      const span = document.createElement('span');
      span.textContent = crit;
      label.appendChild(input);
      label.appendChild(span);
      checklistEl.appendChild(label);
    });

    const essayEl = document.getElementById('essay');
    essayEl.value = rState.text;
    updateEssayMeta();
  }

  document.getElementById('reveal-btn').addEventListener('click', () => {
    document.getElementById('redac-expected').classList.toggle('show');
  });

  function updateEssayMeta() {
    const essayEl = document.getElementById('essay');
    const words = essayEl.value.trim().split(/\s+/).filter(Boolean).length;
    document.getElementById('essay-count').textContent = `${words} mot${words > 1 ? 's' : ''}`;
    document.getElementById('essay-saved').textContent = essayEl.value ? 'Enregistré sur cet appareil' : 'Non enregistré';
  }
  document.getElementById('essay').addEventListener('input', () => {
    saveCurrentEssay();
    updateEssayMeta();
    updateDashboard();
  });

  // ---------- Dashboard ----------
  function updateDashboard() {
    const mastered = state.cards.filter(c => c.level >= LEVEL_INTERVALS.length - 1).length;
    document.getElementById('dash-flash-text').textContent = `${mastered} / ${flashcards.length}`;
    document.getElementById('dash-flash-bar').style.width = Math.round((mastered / flashcards.length) * 100) + '%';

    if (state.qcmBest > 0) {
      document.getElementById('dash-qcm-text').textContent = `${state.qcmBest} / ${qcm.length}`;
      document.getElementById('dash-qcm-bar').style.width = Math.round((state.qcmBest / qcm.length) * 100) + '%';
    } else {
      document.getElementById('dash-qcm-text').textContent = 'Non tenté';
      document.getElementById('dash-qcm-bar').style.width = '0%';
    }

    const validatedCount = redacQuestions.filter((_, i) => isValidated(i)).length;
    document.getElementById('dash-redac-text').textContent = `${validatedCount} / ${redacQuestions.length}`;
    document.getElementById('dash-redac-bar').style.width = Math.round((validatedCount / redacQuestions.length) * 100) + '%';
  }

  function renderCalendar() {
    const steps = [
      { tag: 'Jour J', offset: 0 },
      { tag: 'J+1', offset: 1 },
      { tag: 'J+3', offset: 3 },
      { tag: 'J+7', offset: 7 },
      { tag: 'J+15', offset: 15 },
    ];
    const el = document.getElementById('calendar-steps');
    el.innerHTML = '';
    steps.forEach(s => {
      const div = document.createElement('div');
      div.className = 'calendar-step';
      div.innerHTML = `<div class="tag">${s.tag}</div><div class="date">${fmtDate(addDaysISO(s.offset))}</div>`;
      el.appendChild(div);
    });
  }

  document.getElementById('reset-btn').addEventListener('click', () => {
    if (confirm('Réinitialiser toute ta progression (flashcards, QCM, rédactions) ? Cette action est irréversible.')) {
      localStorage.removeItem(STORAGE_KEY);
      state = {
        cards: flashcards.map(() => ({ level: 0, nextReview: todayISO() })),
        qcmBest: 0,
        redac: redacQuestions.map(() => ({ text: '', checklist: [] })),
      };
      save();
      fIndex = 0; qIndex = 0; qAnswers = []; rIndex = 0;
      renderFlash(); renderQcm(); renderRedac(); updateDashboard();
    }
  });

  // ---------- Initialisation ----------
  renderFlash();
  renderQcm();
  renderRedac();
  renderCalendar();
  updateDashboard();
})();
</script>

</body>
</html>
