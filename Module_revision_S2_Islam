    </div>
    <div id="qcm-result" style="display:none;">
      <div class="qcm-card qcm-result">
        <div class="eyebrow" style="color:var(--accent);font-weight:700;font-size:.8rem;text-transform:uppercase;">QCM terminé</div>
        <div class="score" id="qcm-final-score">0 / 20</div>
        <p id="qcm-final-msg" style="color:var(--ink-soft);"></p>
        <div class="priority-list" id="qcm-priority" style="display:none;">
          <h4>Notions à revoir en priorité</h4>
          <ul id="qcm-priority-list"></ul>
        </div>
        <button id="qcm-restart" style="font-family:var(--font);font-weight:700;padding:12px 20px;border-radius:10px;border:none;background:var(--accent-dark);color:#fff;cursor:pointer;margin-top:16px;">Recommencer</button>
      </div>
