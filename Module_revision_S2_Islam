    <div class="reset-row">
      <button class="reset-btn" id="reset-btn">Réinitialiser ma progression</button>
    </div>
  </section>

  <!-- FLASHCARDS -->
  <section class="panel" id="panel-flashcards">
    <div class="flash-wrap">
      <div class="flash-meta">
        <span id="flash-count">Carte 1 / 20</span>
        <span id="flash-status" class="flash-status">À revoir aujourd'hui</span>
      </div>
      <div class="flash-card" id="flash-card">
        <div class="flash-inner" id="flash-inner">
          <div class="flash-face flash-front">
            <div class="theme" id="flash-theme">Thème</div>
            <p class="q" id="flash-q">Question</p>
            <p class="flash-hint">Clique pour retourner</p>
          </div>
          <div class="flash-face flash-back">
            <p class="a" id="flash-a">Réponse</p>
            <p class="flash-hint">Clique pour revenir</p>
          </div>
        </div>
      </div>
      <div class="flash-actions">
        <button class="btn-revoir" id="btn-revoir">À revoir</button>
        <button class="btn-presque" id="btn-presque">Presque</button>
        <button class="btn-sais" id="btn-sais">Je sais !</button>
      </div>
      <div class="flash-nav">
        <button id="flash-prev">‹ Précédente</button>
        <span style="font-size:.75rem;opacity:.6;">clique la carte pour voir la réponse</span>
        <button id="flash-next">Suivante ›</button>
