  </section>

  <!-- QCM -->
  <section class="panel" id="panel-qcm">
    <div id="qcm-active">
      <div class="qcm-card">
        <div class="qcm-theme" id="qcm-theme">Thème</div>
        <div class="bar" style="margin-bottom:16px;"><span id="qcm-progress" style="width:0%"></span></div>
        <p class="qcm-q" id="qcm-q">Question</p>
        <div class="qcm-options" id="qcm-options"></div>
        <div class="qcm-explain" id="qcm-explain"></div>
