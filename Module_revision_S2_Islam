        </div>
        <div class="checklist">
          <h3>Grille d'auto-évaluation</h3>
          <div id="redac-checklist"></div>
        </div>
      </div>
      <div>
        <textarea class="essay" id="essay" placeholder="Rédige ta réponse ici..."></textarea>
        <div class="essay-meta">
          <span id="essay-count">0 mot</span>
          <span id="essay-saved" style="opacity:.6;">Non enregistré</span>
        </div>
      </div>
